generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File {
  id          Int          @id @default(autoincrement())
  name        String
  storagePath String
  mimeType    String?
  sizeBytes   Int?
  uploadedAt  DateTime     @default(now())
  clauses     FileClause[]
}

model Clause {
  id               Int          @id @default(autoincrement())
  code             String       @unique
  standard         String       @default("iso9001")  // "iso9001" or "iso27001"
  type             String       @default("question")  // "section", "subsection", "question"
  isoClause        String?
  auditQuestion    String?
  std              String?
  cycle            String?
  responsibleParty String?
  // ISO 27001 specific
  category         String?
  title            String?
  description      String?
  reference        String?
  evaluatorNotes   String?
  evidenceJson     String?
  files            FileClause[]
}

model FileClause {
  fileId    Int
  clauseId  Int
  comment   String?
  createdAt DateTime @default(now())
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  clause    Clause   @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  @@id([fileId, clauseId])
  @@index([clauseId])
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @default("")
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user")
}

enum Role {
  USER
  ADMIN
  GUEST
}

model ChangeLog {
  id          Int      @id @default(autoincrement())
  action      String
  description String
  performedBy String   @default("admin")
  createdAt   DateTime @default(now())
}